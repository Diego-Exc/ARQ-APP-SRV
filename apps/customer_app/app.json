{
  "expo": {
    "name": "ArreglaPues Cliente",
    "slug": "arreglapues-customer-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {},
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "ArreglaPues necesita acceso a tus fotos para adjuntarlas al diagnóstico del daño."
        }
      ]
    ]
  }
}
